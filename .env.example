# Copy this file to ".env" and fill in the values from your Firebase project.
# Firebase Console -> Project settings -> General -> "Your apps" -> Web app -> SDK setup and configuration.
# NOTE: these Firebase web values are public identifiers by design (they are not secrets).
# Your data is protected by Firestore security rules (see firestore.rules), not by hiding these.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# OPTIONAL: URL of YOUR OWN backend proxy that calls a real AI model.
# Never put an AI provider secret key in this file or in frontend code.
# See README.md -> "Connecting a real AI API".
VITE_AI_PROXY_URL=
