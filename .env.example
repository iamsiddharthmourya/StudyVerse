# Copy this file to ".env" and fill in the values from your Firebase project.
# Firebase Console -> Project settings -> General -> "Your apps" -> Web app -> SDK setup and configuration.
# NOTE: these Firebase web values are public identifiers by design (they are not secrets).
# Your data is protected by Firestore security rules (see firestore.rules), not by hiding these.
VITE_FIREBASE_API_KEY=AIzaSyBIv2dBP3s-twTLV8N_fgG1JkIBIaRjsrQ
VITE_FIREBASE_AUTH_DOMAIN=studyverse-54c89.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=studyverse-54c89
VITE_FIREBASE_STORAGE_BUCKET=studyverse-54c89.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=studyverse-54c89.firebasestorage.app
VITE_FIREBASE_APP_ID=1:730278869847:web:8533b3413e3a1c21f45c12

# OPTIONAL: URL of YOUR OWN backend proxy that calls a real AI model.
# Never put an AI provider secret key in this file or in frontend code.
# See README.md -> "Connecting a real AI API".
VITE_AI_PROXY_URL=

# ==============================================================================
# QuizVerse Gemini AI Serverless Backend (Server-Side Only)
# Configure these in your Vercel Project Settings -> Environment Variables.
# NEVER prefix with VITE_ so they remain strictly hidden from browser bundles.
# ==============================================================================
# Your Google Gemini API Key from Google AI Studio (https://aistudio.google.com/):
GEMINI_API_KEY=

# Supported Gemini Model (defaults to gemini-2.0-flash, fallback to gemini-1.5-flash):
GEMINI_MODEL=gemini-2.0-flash

# Optional secret seed for signing Guest Mode HMAC session tokens:
SESSION_SECRET=

# Optional: Shared Distributed Store for Multi-Instance Concurrency Enforcement (Vercel KV / Upstash Redis)
# Automatically populated by Vercel when connecting Vercel KV storage:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
